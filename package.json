{
  "name": "player-type-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "独立的 Poker lookup 玩家风格实验、缓存和离线报告工具",
  "engines": {
    "bun": ">=1.3.10"
  },
  "scripts": {
    "web": "bun run src/web/server.ts",
    "lookup": "bun run src/cli/lookup.ts",
    "test:ai:profiles": "bun run src/cli/lookup.ts",
    "test": "bun test --isolate tests",
    "check:type": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write src tests package.json tsconfig.json eslint.config.js",
    "format:check": "prettier --check src tests package.json tsconfig.json eslint.config.js"
  },
  "dependencies": {
    "axios": "1.20.0",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "bun-types": "1.4.2",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
