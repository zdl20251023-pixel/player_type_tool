# 复制为 .env 后填写；不随迁移复制原项目的真实配置或凭据。
AI_SERVICE_URL=
AI_USE_PROXY=false
AI_PROXY_URL=
AI_REQUEST_TIMEOUT_MS=3000

# Web 工具（默认仅本机访问）
WEB_PORT=3210
WEB_HOST=127.0.0.1
WEB_ALLOWED_HOSTS=
# 局域网共享示例：WEB_HOST=0.0.0.0，WEB_ALLOWED_HOSTS=10.10.1.12
# IP 变化后同步更新允许地址；多个访问地址以逗号分隔。
# 首次启动的默认模型；也可在 Web 设置中选择和编辑。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
